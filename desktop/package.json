{
  "name": "palacio-mental-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "copy-renderer": "node copy-renderer.js",
    "start": "npm run copy-renderer && electron .",
    "dist": "npm run copy-renderer && electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.palaciomental.desktop",
    "productName": "Palácio Mental",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
