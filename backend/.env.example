# Copie este arquivo para ".env" (mesma pasta) e preencha com sua própria chave.
# O backend carrega ".env" automaticamente ao iniciar (via "dotenv/config").

# Chave da API do Giphy — pegue a sua grátis em https://developers.giphy.com/dashboard/
GIPHY_API_KEY=sua_chave_aqui

# Opcional: segredo do JWT (login) — recomendado em produção.
# JWT_SECRET=gere_um_valor_aleatorio

# Opcional: pasta onde ficam o banco de dados e os uploads.
# DATA_DIR=/var/data
