# Copie este arquivo para ".env.production" (mesma pasta) e preencha com a URL
# pública do seu backend (o link do Render, por exemplo).
# O Vite lê ".env.production" automaticamente sempre que você roda "npm run build".
#
# Necessário tanto pro deploy web separado (frontend/backend em domínios diferentes)
# quanto pro app desktop (Electron), já que nenhum dos dois carrega a página a partir
# do próprio domínio do backend.

VITE_API_URL=https://seu-app.onrender.com
VITE_SOCKET_URL=https://seu-app.onrender.com
